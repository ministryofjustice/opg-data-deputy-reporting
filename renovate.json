{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",

  "enabled": true,
  "timezone": "Europe/London",

  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],

  "branchPrefix": "renovate/",
  "labels": ["dependencies", "renovate"],
  "rebaseWhen": "conflicted",
  "dependencyDashboard": true,
  "branchConcurrentLimit": 5,
  "prHourlyLimit": 2,

  "minimumReleaseAge": "7 days",

  "packageRules": [
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true,
      "labels": ["dependencies", "renovate", "major"],
      "minimumReleaseAge": "7 days"
    },
    {
      "isVulnerabilityAlert": true,
      "labels": ["dependencies", "renovate", "security"],
      "prPriority": 10,
      "prCreation": "immediate",
      "matchPackageNames": ["*"]
    },
    {
      "groupName": "Terraform dependency updates",
      "matchManagers": ["terraform"],
      "matchUpdateTypes": ["minor", "patch"],
      "labels": ["dependencies", "terraform"],
      "schedule": ["before 9am on Monday"],
      "minimumReleaseAge": "7 days"
    },
    {
      "description": ["Disable Docker digest-only updates"],
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["digest"],
      "enabled": false
    },
    {
      "groupName": "Docker image updates",
      "matchManagers": ["dockerfile", "docker-compose"],
      "matchUpdateTypes": ["minor", "patch"],
      "labels": ["dependencies", "docker"],
      "schedule": ["before 9am on Tuesday"],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "GitHub Actions",
      "matchManagers": ["github-actions"],
      "labels": ["dependencies", "github-actions"],
      "automerge": true,
      "schedule": ["before 9am on Wednesday"],
      "minimumReleaseAge": "7 days"
    },
    {
      "groupName": "Python dependency updates",
      "matchManagers": ["pep621", "pip_requirements", "pip-compile"],
      "matchUpdateTypes": ["minor", "patch"],
      "labels": ["dependencies", "python"],
      "schedule": ["before 9am on Thursday"],
      "minimumReleaseAge": "7 days"
    },
    {
      "matchManagers": ["pep621", "pip_requirements", "pip-compile"],
      "rangeStrategy": "bump"
    },
    {
      "groupName": "Golang dependency updates",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "labels": ["dependencies", "golang"],
      "schedule": ["before 9am on Friday"],
      "minimumReleaseAge": "7 days"
    }
  ]
}
